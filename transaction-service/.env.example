# Copy to .env for local Docker Compose use. Never commit .env or production secrets.
DOMAIN=pulseops.example.com
DB_USERNAME=pulseops
DB_PASSWORD=replace-with-a-local-password
POSTGRES_DB=pulseops
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Host-facing service endpoints used by local development.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pulseops
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
